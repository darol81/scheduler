# Response headers for the Cloudflare Pages deploy. Vite copies public/ to the
# root of dist/, which is where Pages looks for this file. It has no effect on
# `npm run dev` or `vite preview` -- only the edge reads it.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

# Vite content-hashes every filename under /assets/, so a changed file is a
# changed URL and these can be cached forever. index.html is deliberately not
# covered -- it must stay revalidated or a deploy would never reach anyone.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# No Content-Security-Policy on purpose: Recharts writes inline style
# attributes, so a useful policy needs style-src 'unsafe-inline' and has to be
# verified against a real deploy rather than guessed at here.
#
# No Strict-Transport-Security either: pages.dev is already on the HSTS preload
# list, so it would be redundant. Add it when a custom domain is attached --
# that is the point at which it becomes a commitment worth making explicitly.
